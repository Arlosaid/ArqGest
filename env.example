# ==============================================
# ARC MANAGER - Configuración de Variables de Entorno
# ==============================================

# ================================================
# CONFIGURACIÓN BÁSICA
# ================================================
DEBUG=True
SECRET_KEY=dev-insecure-key-change-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ================================================
# BASE DE DATOS
# ================================================
# Para desarrollo local (usar PostgreSQL con Docker)
DATABASE_URL=postgresql://postgres:postgres123@localhost:5432/arc_manager_dev

# Para producción (Railway auto-genera esta variable)
# DATABASE_URL=postgresql://user:pass@host:5432/production_db

# ================================================
# CONFIGURACIÓN DE ALMACENAMIENTO
# ================================================

# 🟢 DESARROLLO LOCAL (usar archivos locales)
ENABLE_STORAGES=false

# 🔵 PRODUCCIÓN (usar Cloudflare R2)
# ENABLE_STORAGES=true
# CLOUDFLARE_R2_ENDPOINT_URL=https://tu-account-id.r2.cloudflarestorage.com
# CLOUDFLARE_R2_BUCKET_NAME=nombre-de-tu-bucket
# CLOUDFLARE_R2_ACCESS_KEY_ID=tu-r2-access-key
# CLOUDFLARE_R2_SECRET_ACCESS_KEY=tu-r2-secret-key
# CLOUDFLARE_R2_REGION=auto

# Variables alternativas (compatibilidad con configuración anterior)
# AWS_S3_ENDPOINT_URL=https://account-id.r2.cloudflarestorage.com
# AWS_STORAGE_BUCKET_NAME=bucket-name
# AWS_ACCESS_KEY_ID=access-key
# AWS_SECRET_ACCESS_KEY=secret-key

# ================================================
# CONFIGURACIÓN DE ARCHIVOS
# ================================================
# Límite de tamaño de archivos en MB
MAX_FILE_SIZE_MB=600

# Extensiones permitidas (separadas por comas)
ALLOWED_EXTENSIONS=PDF,JPG,JPEG,PNG,GIF,DWG,DXF,RVT,SKP,ZIP,RAR,TIFF,DOC,DOCX,XLS,XLSX,PPT,PPTX,TXT,MD

# ================================================
# CACHE Y REDIS
# ================================================
# Para desarrollo local
REDIS_URL=redis://localhost:6379/0

# Para producción
# REDIS_URL=redis://redis-host:6379/0

# ================================================
# EMAIL CONFIGURATION
# ================================================
# 🚀 Opción 1: Resend (Recomendado)
# RESEND_API_KEY=re_your_api_key_here
# DEFAULT_FROM_EMAIL=noreply@tu-dominio.com

# 🔧 Opción 2: AWS SES (Fallback)
# AWS_SES_HOST=email-smtp.us-west-1.amazonaws.com
# AWS_SES_PORT=587
# AWS_SES_USER=tu-ses-user
# AWS_SES_PASS=tu-ses-password
# DEFAULT_FROM_EMAIL=noreply@tu-dominio.com

# ================================================
# LOGGING
# ================================================
LOG_LEVEL=INFO

# ================================================
# CONFIGURACIÓN DE PRODUCCIÓN
# ================================================
# Solo para producción - no usar en desarrollo
# PRODUCTION=true
# RAILWAY_ENVIRONMENT=production

# ================================================
# CONFIGURACIÓN DE PUERTO (Docker)
# ================================================
WEB_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379

# ================================================
# CONFIGURACIÓN DE BASE DE DATOS POSTGRESQL
# ================================================
POSTGRES_DB=arc_manager_dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123

# ================================================
# INSTRUCCIONES DE USO
# ================================================
# 
# 1. DESARROLLO LOCAL:
#    - Copia este archivo como .env
#    - Mantén ENABLE_STORAGES=false
#    - Los archivos se guardarán en ./arc_manager/media/
#
# 2. PRODUCCIÓN:
#    - Configura ENABLE_STORAGES=true
#    - Proporciona todas las variables CLOUDFLARE_R2_* para R2
#    - Los archivos se guardarán en tu bucket Cloudflare R2
#
# 3. VARIABLES CRÍTICAS PARA PRODUCCIÓN:
#    ✅ SECRET_KEY (generar una nueva y segura)
#    ✅ DEBUG=False
#    ✅ ALLOWED_HOSTS (tu dominio)
#    ✅ DATABASE_URL (auto-generada por Railway)
#    ✅ ENABLE_STORAGES=true
#    ✅ Todas las variables CLOUDFLARE_R2_* para R2
#
