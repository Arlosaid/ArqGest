# Configuración de la aplicación
DEBUG=False
SECRET_KEY=your-secret-key-here
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Configuración de la base de datos PostgreSQL
DATABASE_URL=postgresql://username:password@host:5432/database_name

# Configuración de PostgreSQL (para docker-compose)
POSTGRES_DB=your_database_name
POSTGRES_USER=your_username
POSTGRES_PASSWORD=your_password

# Puertos para docker-compose
POSTGRES_PORT=5432
WEB_PORT=8000
REDIS_PORT=6379
CONN_MAX_AGE=120

# Configuración de Amazon SES para correos
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_SES_REGION=us-east-1
DEFAULT_FROM_EMAIL=noreply@tudominio.com
AWS_SES_CONFIGURATION_SET=

# Almacenamiento (Cloudflare R2 / S3)
# Para activar django-storages, descomenta y configura:
# DEFAULT_FILE_STORAGE=storages.backends.s3boto3.S3Boto3Storage
# AWS_S3_ENDPOINT_URL=https://<accountid>.r2.cloudflarestorage.com
# AWS_STORAGE_BUCKET_NAME=your_bucket
# R2_ACCESS_KEY_ID=your_r2_access_key
# R2_SECRET_ACCESS_KEY=your_r2_secret
# AWS_S3_REGION_NAME=auto
# AWS_S3_ADDRESSING_STYLE=virtual
# AWS_S3_SIGNATURE_VERSION=s3v4

# Validaciones de archivos
MAX_FILE_SIZE_MB=600
ALLOWED_EXTENSIONS=PDF,JPG,JPEG,PNG,GIF,DWG,DXF,RVT,SKP,ZIP,RAR,TIFF
ENABLE_STORAGES=false