# Configuración de la aplicación
DEBUG=False
SECRET_KEY=your-secret-key-here
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Configuración de la base de datos PostgreSQL
DATABASE_URL=postgresql://username:password@host:5432/database_name

# Configuración de PostgreSQL (para docker-compose)
POSTGRES_DB=your_database_name
POSTGRES_USER=your_username
POSTGRES_PASSWORD=your_password

# Puertos para docker-compose
POSTGRES_PORT=5432
WEB_PORT=8000
REDIS_PORT=6379
CONN_MAX_AGE=120

# Configuración de correos con AWS SES
# ✅ 62,000 emails/mes GRATIS para siempre
# ✅ Excelente deliverability y reputación
# ✅ Integración nativa con AWS
# Variables que debes configurar en Railway:
AWS_SES_USER=tu_access_key_id_de_iam
AWS_SES_PASS=tu_smtp_password_generado
AWS_SES_HOST=email-smtp.us-east-1.amazonaws.com
AWS_SES_PORT=587
DEFAULT_FROM_EMAIL=tu_email@verificado_en_ses.com

# Almacenamiento (Cloudflare R2 / S3) - CRÍTICO PARA PRODUCCIÓN
# Para activar almacenamiento externo, configura estas variables:
ENABLE_STORAGES=false
# DEFAULT_FILE_STORAGE=storages.backends.s3boto3.S3Boto3Storage
# AWS_S3_ENDPOINT_URL=https://<accountid>.r2.cloudflarestorage.com
# AWS_STORAGE_BUCKET_NAME=your_bucket_name
# AWS_ACCESS_KEY_ID=your_r2_access_key
# AWS_SECRET_ACCESS_KEY=your_r2_secret
# AWS_S3_REGION_NAME=auto
# AWS_S3_ADDRESSING_STYLE=virtual
# AWS_S3_SIGNATURE_VERSION=s3v4
# AWS_S3_CUSTOM_DOMAIN=your_bucket_name.r2.dev  # opcional
# AWS_DEFAULT_ACL=  # R2 no usa ACLs

# Validaciones de archivos (para estudios de arquitectura)
MAX_FILE_SIZE_MB=600
ALLOWED_EXTENSIONS=PDF,JPG,JPEG,PNG,GIF,DWG,DXF,RVT,SKP,ZIP,RAR,TIFF,DOC,DOCX,XLS,XLSX
MAX_CHECKSUM_MB=50

# Redis Cache
REDIS_URL=redis://localhost:6379/0

# AWS S3 (opcional, para archivos)
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=

# AWS SES - Variables ya configuradas arriba
# Estas variables son las que debes configurar en Railway:
# AWS_SES_USER=tu_access_key_id_de_iam
# AWS_SES_PASS=tu_smtp_password_generado  
# AWS_SES_HOST=email-smtp.us-east-1.amazonaws.com
# AWS_SES_PORT=587
# DEFAULT_FROM_EMAIL=tu_email@verificado_en_ses.com