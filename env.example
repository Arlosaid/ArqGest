# Configuración de la aplicación
DEBUG=False
SECRET_KEY=your-secret-key-here
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Configuración de la base de datos PostgreSQL
DATABASE_URL=postgresql://username:password@host:5432/database_name

# Configuración de PostgreSQL (para docker-compose)
POSTGRES_DB=your_database_name
POSTGRES_USER=your_username
POSTGRES_PASSWORD=your_password

# Puertos para docker-compose
POSTGRES_PORT=5432
WEB_PORT=8000
REDIS_PORT=6379
CONN_MAX_AGE=120

# Configuración de correos con SendGrid
# ✅ 100 emails/día GRATIS para siempre
# ✅ Acepta Gmail, Yahoo, etc. para registro
# ✅ Excelente deliverability
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.sendgrid.net
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=apikey
EMAIL_HOST_PASSWORD=tu_api_key_de_sendgrid
EMAIL_TIMEOUT=30
DEFAULT_FROM_EMAIL=tu_email@gmail.com

# Almacenamiento (Cloudflare R2 / S3) - CRÍTICO PARA PRODUCCIÓN
# Para activar almacenamiento externo, configura estas variables:
ENABLE_STORAGES=false
# DEFAULT_FILE_STORAGE=storages.backends.s3boto3.S3Boto3Storage
# AWS_S3_ENDPOINT_URL=https://<accountid>.r2.cloudflarestorage.com
# AWS_STORAGE_BUCKET_NAME=your_bucket_name
# AWS_ACCESS_KEY_ID=your_r2_access_key
# AWS_SECRET_ACCESS_KEY=your_r2_secret
# AWS_S3_REGION_NAME=auto
# AWS_S3_ADDRESSING_STYLE=virtual
# AWS_S3_SIGNATURE_VERSION=s3v4
# AWS_S3_CUSTOM_DOMAIN=your_bucket_name.r2.dev  # opcional
# AWS_DEFAULT_ACL=  # R2 no usa ACLs

# Validaciones de archivos (para estudios de arquitectura)
MAX_FILE_SIZE_MB=600
ALLOWED_EXTENSIONS=PDF,JPG,JPEG,PNG,GIF,DWG,DXF,RVT,SKP,ZIP,RAR,TIFF,DOC,DOCX,XLS,XLSX
MAX_CHECKSUM_MB=50