# ========================================
# CONFIGURACIÓN BÁSICA
# ========================================
DEBUG=True
SECRET_KEY=change-this-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Indicador de entorno Docker (mejora rendimiento de logging)
DOCKER_CONTAINER=false

# ========================================
# BASE DE DATOS
# ========================================
DATABASE_URL=postgresql://postgres:postgres123@db:5432/arc_manager_dev

# ========================================
# REDIS (CACHE)
# ========================================
REDIS_URL=redis://redis:6379/0

# ========================================
# CLOUDFLARE R2 / S3 STORAGE (OPCIONAL)
# ========================================
ENABLE_STORAGES=false
CLOUDFLARE_R2_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com
CLOUDFLARE_R2_BUCKET_NAME=your-bucket-name
CLOUDFLARE_R2_ACCESS_KEY_ID=your-access-key
CLOUDFLARE_R2_SECRET_ACCESS_KEY=your-secret-key
CLOUDFLARE_R2_REGION=auto

# ========================================
# 🚀 OPTIMIZACIÓN ULTRA - ARCHIVOS MASIVOS
# ========================================

# Tamaño máximo de archivos (1.2GB para modelos BIM)
MAX_FILE_SIZE_MB=1200

# Límite HTTP para requests (1.25GB)
DATA_UPLOAD_MAX_NUMBER_SIZE=1342177280

# Memoria máxima para archivos en RAM (25MB)
DATA_UPLOAD_MAX_MEMORY_SIZE=26214400

# Directorio temporal para uploads grandes
FILE_UPLOAD_TEMP_DIR=/app/temp_uploads

# Tamaño máximo para calcular checksum (50MB)
MAX_CHECKSUM_MB=50

# ========================================
# EXTENSIONES PERMITIDAS (ARQUITECTURA)
# ========================================
ALLOWED_EXTENSIONS=PDF,JPG,JPEG,PNG,GIF,DWG,DXF,RVT,SKP,3DS,MAX,ZIP,RAR,7Z,TIFF,DOC,DOCX,XLS,XLSX,PPT,PPTX,TXT,MD

# ========================================
# RATE LIMITING OPTIMIZADO PARA ARQUITECTOS
# ========================================

# Uploads por minuto (15 para proyectos grandes)
FILE_UPLOAD_RATE_LIMIT_MINUTE=15

# Uploads por hora (200 para equipos colaborativos)
FILE_UPLOAD_RATE_LIMIT_HOUR=200

# Tamaño total por hora (5GB para archivos pesados)
FILE_UPLOAD_SIZE_LIMIT_HOUR_MB=5000

# ========================================
# CONFIGURACIÓN R2 ULTRA-OPTIMIZADA
# ========================================

# Threshold para iniciar multipart (25MB)
AWS_S3_MULTIPART_THRESHOLD=26214400

# Tamaño de chunks (50MB para menos overhead)
AWS_S3_MULTIPART_CHUNKSIZE=52428800

# Conexiones concurrentes (15 para máximo paralelismo)
AWS_S3_MAX_CONCURRENCY=15

# Timeout de conexión (2 minutos para redes lentas)
AWS_S3_CONNECT_TIMEOUT=120

# Timeout de lectura (30 minutos para archivos masivos)
AWS_S3_READ_TIMEOUT=1800

# Pool de conexiones (50 conexiones)
AWS_S3_MAX_POOL_CONNECTIONS=50

# Intentos de retry (5 intentos con backoff)
AWS_S3_RETRY_ATTEMPTS=5

# Expiración de URLs presignadas (2 horas)
PRESIGN_EXPIRES_SECONDS=7200

# ========================================
# EMAIL (RESEND)
# ========================================
RESEND_API_KEY=your-resend-api-key
DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# ========================================
# INFORMACIÓN DEL SITIO
# ========================================
SITE_NAME=ARC Manager
SITE_DOMAIN=localhost:8000
SITE_URL=http://localhost:8000

# ========================================
# INFORMACIÓN DE PAGOS (OPCIONAL)
# ========================================
PAYMENT_BANK_NAME=Banco BBVA
PAYMENT_ACCOUNT_HOLDER=TU EMPRESA SA DE CV
PAYMENT_ACCOUNT_NUMBER=0123456789
PAYMENT_CLABE=012345678901234567
PAYMENT_CONCEPT_PREFIX=Upgrade-Plan

# ========================================
# SOPORTE
# ========================================
ADMIN_EMAIL=admin@yourdomain.com
SUPPORT_EMAIL=soporte@yourdomain.com
SUPPORT_PHONE=55 1234 5678

# ========================================
# PLANES Y SUSCRIPCIONES
# ========================================
# Días antes del vencimiento para renovar anticipadamente
RENEWAL_WINDOW_DAYS=3

# ========================================
# CONFIGURACIÓN PARA EQUIPOS GRANDES (OPCIONAL)
# ========================================
# Descomentar para estudios grandes de arquitectura (10+ usuarios)
# MAX_FILE_SIZE_MB=2000  # 2GB
# FILE_UPLOAD_SIZE_LIMIT_HOUR_MB=10000  # 10GB/hora
# AWS_S3_MAX_CONCURRENCY=20  # 20 conexiones paralelas
