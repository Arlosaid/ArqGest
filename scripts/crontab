# ====================================
# CRON JOBS PARA ARC MANAGER
# ====================================
# Este archivo configura tareas programadas para el contenedor de cron
# Formato: minuto hora dia mes dia_semana comando

# ====================================
# SUSCRIPCIONES - Actualizar estados
# ====================================
# Ejecuta cada hora para mantener los estados de suscripción actualizados
# Detecta suscripciones expiradas y las mueve a período de gracia o las expira
0 * * * * cd /app/arc_manager && python manage.py update_subscription_states >> /app/logs/cron.log 2>&1

# ====================================
# EMAILS - Recordatorios de renovación
# ====================================
# Trial (gratuito): Enviar recordatorio 3 días antes
0 9 * * * cd /app/arc_manager && python manage.py send_trial_reminder --days=3 >> /app/logs/cron.log 2>&1

# Plan básico: Enviar recordatorio 1 día antes (mañana vence)
0 9 * * * cd /app/arc_manager && python manage.py send_renewal_reminders >> /app/logs/cron.log 2>&1

# ====================================
# LIMPIEZA - Sesiones expiradas (Opcional)
# ====================================
# Opcional: Limpiar sesiones expiradas cada día a las 3:00 AM
# 0 3 * * * cd /app/arc_manager && python manage.py clearsessions >> /app/logs/cron.log 2>&1

# ====================================
# DEBUGGING
# ====================================
# Para debugging: descomentar para verificar que cron está funcionando
# */5 * * * * echo "Cron is alive - $(date)" >> /app/logs/cron.log 2>&1
