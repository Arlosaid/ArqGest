{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile"
  },
  "deploy": {
    "numReplicas": 1,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3,
    "healthcheckPath": "/health/",
    "healthcheckTimeout": 10,
    "startCommand": "/app/start.sh",
    "resources": {
      "limits": {
        "cpu": "1000m",
        "memory": "1Gi"
      }
    }
  }
}

