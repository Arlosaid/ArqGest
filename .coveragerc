[run]
source = arc_manager
omit = 
    */migrations/*
    */tests/*
    */test_*.py
    */__pycache__/*
    */settings.py
    */wsgi.py
    */asgi.py
    manage.py
    */venv/*
    */virtualenv/*
    */env/*
    */.venv/*
    */site-packages/*

[report]
precision = 2
show_missing = True
skip_covered = False

exclude_lines =
    pragma: no cover
    def __repr__
    def __str__
    raise AssertionError
    raise NotImplementedError
    if __name__ == .__main__.:
    if settings.DEBUG:
    if TYPE_CHECKING:
    @abstract
    @abc.abstractmethod
    @property
    pass

[html]
directory = htmlcov
title = ARC Manager Test Coverage Report
